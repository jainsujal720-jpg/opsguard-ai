        "sendTo": "={{ $('Receive Synthetic Case Result').item.json.body.test_customer_email }}",
        "subject": "=OpsGuard TEST — Refund approved for {{ $('Receive Synthetic Case Result').item.json.body.case_result.case_id }}",
        "emailType": "text",
        "message": "=SYNTHETIC TEST — No real refund has been issued.\n\nGood news — your refund request for ₹{{ $('Receive Synthetic Case Result').item.json.body.case_result.approval_control.requested_refund_inr }} has been approved.\n\nIn a live EzyHelpers service, the refund would now be sent to the original payment method. We would show the payment provider's confirmed completion estimate instead of leaving you uncertain.\n\nWe will continue coordinating the service resolution described in your earlier update. You do not need to take any further action right now.\n\nCase ID: {{ $('Receive Synthetic Case Result').item.json.body.case_result.case_id }}",
        "options": {
          "appendAttribution": false,
          "senderName": "OpsGuard AI Test"
        }
      },
