        "nodeCredentialType": "twilioApi",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "To",
              "value": "whatsapp:+REPLACE_WITH_TEST_RECIPIENT"
            },
            {
              "name": "From",
              "value": "whatsapp:+REPLACE_WITH_TWILIO_SANDBOX_NUMBER"
            },
            {
              "name": "ContentSid",
              "value": "REPLACE_WITH_TWILIO_CONTENT_SID"
            }
          ]
        },
        "options": {}
      },
